# Cybersecurity Command Center — example environment.
# Copy this file to .env and adjust as needed.
# NEVER commit the real .env file (it's gitignored).

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite database URL. The path must be absolute.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── Authentication ─────────────────────────────────────────────────────────
# Default credentials (used when no UserPassword row exists in the DB).
# After first login, change the password via Settings → Change Password.
# The password change is stored in the DB and takes effect immediately.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Session signing secret. Set to a strong random value in production.
# Default is derived from the DB path (adequate for local-only).
# AUTH_SECRET=your-random-32+char-secret

# Disable authentication entirely (local-only trusted mode).
# When disabled, all requests are treated as the local role.
# WARNING: Do not use AUTH_DISABLED=true in any network-exposed deployment.
# AUTH_DISABLED=false

# Role assigned when auth is disabled.
# AUTH_LOCAL_ROLE=ADMIN

# ─── Storage (configurable) ─────────────────────────────────────────────────
# Cache directory for CVE/vulnerability data.
# Default: /home/z/my-project/cache
# CACHE_DIR=/home/z/my-project/cache

# ─── Cookie Security ───────────────────────────────────────────────────────
# Set to true to add the Secure flag to cookies (requires HTTPS).
# Default: true in production, false in development.
# AUTH_COOKIE_SECURE=true

# ─── External Fetch ─────────────────────────────────────────────────────────
# Disable external fetches (OSV.dev, NVD) for air-gapped environments.
# The system will use cached data only.
# EXTERNAL_FETCH_DISABLED=false
